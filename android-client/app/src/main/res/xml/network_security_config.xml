<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is permitted ONLY to the emulator loopback (10.0.2.2),
     for the local lab hub. Every other destination requires TLS. Point the
     app at an https:// hub URL for anything beyond a trusted local lab. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- PHYSICAL-DEVICE LAB OPT-IN:
             To reach a hub on your computer/Pi over plain HTTP from a real
             device, uncomment and set your hub's LAN IP here. Prefer HTTPS
             with your lab CA instead (see LOCAL_SETUP.md); only allow
             cleartext on a trusted lab network.
        <domain includeSubdomains="false">192.168.1.50</domain>
        -->
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
